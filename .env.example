# 云栖酒店 PMS —— 本机环境变量样例
# 用法：复制为仓库根目录下的 `.env`（已被 .gitignore 忽略），按自己的口令填写。
# `.env` 只放本机口令，不要提交；提交的是本文件（.env.example）。

# Django
DJANGO_SECRET_KEY=请替换为随机字符串
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL 18（库 yunqi_hotel 由 sql/00_database.sql 创建）
DB_NAME=yunqi_hotel
DB_USER=yunqi_app
DB_PASSWORD=请填写 sql/91_app_role.sql 里给 yunqi_app 设置的密码
DB_HOST=127.0.0.1
DB_PORT=5432
